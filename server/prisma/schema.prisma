// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  userTopics   UserTopic[]
  favorites    Favorite[]
}

model Topic {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  keywords    String       // General search keywords, source-agnostic
  description String?
  papers      PaperTopic[]
  followers   UserTopic[]
  createdAt   DateTime     @default(now())
}

model UserTopic {
  id          Int      @id @default(autoincrement())
  fkUserId    String
  fkTopicId   Int
  keywords    String?  // Extra personal keywords to narrow the topic
  user        User     @relation(fields: [fkUserId], references: [id])
  topic       Topic    @relation(fields: [fkTopicId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([fkUserId, fkTopicId])
}

model Paper {
  id            Int          @id @default(autoincrement())
  arxivId       String       @unique
  title         String
  abstract      String
  summary       String?
  authors       String
  publishedDate DateTime
  url           String
  score         Float?
  aiSummary     String?
  readabilityScore Int?
  topics        PaperTopic[]
  favorites     Favorite[]
  createdAt     DateTime     @default(now())
}

model PaperTopic {
  fkPaperId Int
  fkTopicId Int
  paper     Paper @relation(fields: [fkPaperId], references: [id])
  topic     Topic @relation(fields: [fkTopicId], references: [id])

  @@id([fkPaperId, fkTopicId])
}

model Favorite {
  fkUserId  String
  fkPaperId Int
  user      User     @relation(fields: [fkUserId], references: [id])
  paper     Paper    @relation(fields: [fkPaperId], references: [id])
  createdAt DateTime @default(now())

  @@id([fkUserId, fkPaperId])
}
